{% set version = tbd_version | default(bookshelf_const_version.tbd, true) %}
{% set web_ui_port = tbd_web_ui_port | default(bookshelf_const_port.tbd.web_ui, true) %}
{% set tag_rex = tbd_tag_rex | default(bookshelf_const_version.tbd_tag_rex, true) %}
---
{{ lookup('template', './../../tailscale/partial/sidecar-compose.yaml.j2', template_vars=dict(
  ts_version = tbd_ts_version | default(bookshelf_const_version.tbd_tailscale, true),
  ts_name = tbd_ts_service_name, ts_conf_dir = conf_dir + '/tailscale'
)) }}

services:
  {{ tbd_service_name }}:
    # https://github.com/spaghetti-coder/tbd-app/pkgs/container/tbd-app
    image: ghcr.io/spaghetti-coder/tbd-app:{{ version }}
    container_name: {{ tbd_service_name }}
    restart: unless-stopped
    labels:
      - wud.watch={{ tbd_wudded }}
      - wud.tag.include={{ tag_rex }}
    env_file:
      - ./secret.env
      - ./main.env
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:{{ tbd_web_ui_port_int }}"]
      interval: 30s
      timeout: 5s
      retries: 3
{% if tbd_tailscaled %}
    network_mode: "service:{{ tbd_ts_service_name }}"

  {{ tbd_ts_service_name }}:
    <<: *tailscale
{% endif %}
    hostname: {{ tbd_hostname }}
{% if web_ui_port | int > -1 %}
    ports: [{{ web_ui_port }}:{{ tbd_web_ui_port_int }}]
{% else %}
    # ports: [ {{ bookshelf_const_port.tbd.web_ui }}:{{ tbd_web_ui_port_int }} ]
{% endif %}
{% if not (nginx_proxy_enabled | default(false)) %}
    network_mode: bridge
{% else %}
    networks:
      - {{ nginx_proxy_net }}
    environment:
      - VIRTUAL_HOST={{ tbd_vhost }}
      - VIRTUAL_PORT={{ tbd_web_ui_port_int }}

networks:
  {{ nginx_proxy_net }}:
    external: true
{% endif %}{#                       <- NETMODE END #}
