{% set version = (kaneo_version | default(bookshelf_const_version.kaneo, true)) %}
{% set web_ui_port = (kaneo_web_ui_port | default(bookshelf_const_port.kaneo.web_ui, true)) %}
{% set tag_rex = kaneo_tag_rex | default(bookshelf_const_version.kaneo_tag_rex, true) %}
---
{{ lookup('template', './../../tailscale/partial/sidecar-compose.yaml.j2', template_vars=dict(
  ts_version = kaneo_ts_version | default(bookshelf_const_version.kaneo_tailscale, true),
  ts_name = kaneo_ts_service_name, ts_conf_dir = conf_dir + '/tailscale'
)) }}
{{ lookup('template', './../../postgres/partial/sidecar-compose.yaml.j2', template_vars=dict(
  pg_version = kaneo_postgres_version | default(bookshelf_const_version.kaneo_postgres, true),
  pg_name = kaneo_db_service_name, pg_conf_dir = conf_dir + '/db', pg_net = kaneo_service_name
)) }}

services:
  {{ kaneo_service_name }}:
    # https://ghcr.io/usekaneo/kaneo
    image: ghcr.io/usekaneo/kaneo:{{ version }}
    container_name: {{ kaneo_service_name }}
    restart: unless-stopped
    labels:
      - wud.watch={{ kaneo_wudded }}
      - wud.tag.include={{ tag_rex }}
    env_file:
      - secret.env
      - main.env    # <- Relies on values from secret.env
    logging:
      options:
        max-size: "10m"
        max-file: "3"
    depends_on:
      {{ kaneo_db_service_name }}:
        condition: service_healthy
        restart: true
{% if kaneo_tailscaled %}
    network_mode: "service:{{ kaneo_ts_service_name }}"

  {{ kaneo_ts_service_name }}:
    <<: *tailscale
{% endif %}{# kaneo_tailscaled #}
    hostname: {{ kaneo_hostname }}
{% if web_ui_port | int > -1 %}
    ports:
      - "{{ web_ui_port }}:{{ kaneo_web_ui_port_int }}"
{% else %}
    # ports:
    #   - "{{ bookshelf_const_port.kaneo.web_ui }}:{{ kaneo_web_ui_port_int }}"
{% endif %}
    networks:
      - {{ kaneo_service_name }}
{% if (nginx_proxy_enabled | default(false)) %}
      - {{ nginx_proxy_net }}
    environment:
      - VIRTUAL_HOST={{ kaneo_vhost }}
      - VIRTUAL_PORT={{ kaneo_web_ui_port_int }}
{% endif %}{# nginx_proxy_enabled #}

  {{ kaneo_db_service_name }}: *postgres

networks:
  {{ kaneo_service_name }}:
    name: {{ kaneo_service_name }}
{% if (nginx_proxy_enabled | default(false)) %}
  {{ nginx_proxy_net }}:
    external: true
{% endif %}{# nginx_proxy_enabled #}
